# Copy this file to .env, then run: docker compose run --rm setup
# The setup wizard fills in most of this for you -- device tokens and
# OMNIMETER_WRITE_API_TOKEN are generated/obtained automatically during
# pairing, not something you need to invent yourself.

# Protects Settings changes and CSV/PDF import uploads (see README's "Write
# authentication"). Auto-generated by the setup wizard if left blank.
OMNIMETER_WRITE_API_TOKEN=

# Device Bearer tokens -- these are written here by the setup wizard when you
# pair each device (P1 meter / Plug-in Battery). No brand name in the key on
# purpose: OmniMeter's device layer (see MeterDevice in src/meter_device.py)
# isn't tied to any one P1-meter vendor, even though HomeWizard is the only
# one implemented today. Leave blank for any device you don't have.
OMNIMETER_P1_TOKEN=
OMNIMETER_BATTERY_TOKEN=
OMNIMETER_WATERMETER_TOKEN=

# YOUR home timezone, as an IANA name -- e.g. Europe/Amsterdam,
# America/New_York, Asia/Kolkata. Full list:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# Change this. It is not cosmetic. It decides where each day starts and ends,
# so it drives the timestamp on every incoming reading, the day boundaries of
# every daily total and chart, the day Open-Meteo aggregates weather into, and
# the start date of any tariff imported from a supplier page that states no
# date of its own. Leaving it at UTC while living somewhere else silently
# shifts readings into the wrong day near midnight -- nothing errors, the
# numbers are just quietly attributed to the wrong date.
#
# An unset value falls back to UTC with a warning in the logs. An invalid name
# stops the app on purpose, rather than starting up and timestamping your data
# in the wrong zone.
OMNIMETER_TIMEZONE=UTC

# Label for the "house" node in the Overview energy-flow diagram. Defaults
# to "Home" if left blank.
OMNIMETER_HOME_LABEL=Home

# Where nightly DB backups land ON YOUR MACHINE (not inside the container --
# docker-compose bind-mounts this path in). Relative paths are relative to
# this file's directory. Retention is 30 days, pruned automatically.
OMNIMETER_BACKUP_HOST_DIR=./backups

# Host port the dashboard is reachable on (http://localhost:<this>).
OMNIMETER_PORT=8000

# --- Weather (optional, OFF by default) -------------------------------------
# Enables daily solar-radiation and temperature data from Open-Meteo, used to
# make the Self-Sufficiency production estimate weather-aware instead of a
# flat monthly average. This is the ONLY part of OmniMeter that talks to the
# internet, so it stays off until you switch it on in Settings.
#
# Your coordinates are sent with each request. They are rounded in code before
# use -- "coarse" keeps 1 decimal place (~11 km), which costs nothing in
# accuracy because the underlying reanalysis grid is ~9 km and discards finer
# detail anyway. Town-level values are perfectly sufficient; there is no
# reason to put your exact address here.
#   coarse  = 1 decimal place (~11 km)  <- default, recommended
#   precise = 2 decimal places (~1 km)
#   exact   = sent as written
OMNIMETER_WEATHER_LATITUDE=
OMNIMETER_WEATHER_LONGITUDE=
OMNIMETER_WEATHER_LOCATION_PRECISION=coarse

# Weather data by Open-Meteo.com is licensed CC BY 4.0. If you display these
# values anywhere, that credit must be shown alongside them.
